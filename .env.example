# ChurchHub environment variables
# Copy to .env and adjust for your environment (do not commit .env)

# Required in production (DEBUG=False)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Development: True | Production: False
DJANGO_DEBUG=True

# Console log level (DEBUG, INFO, WARNING, ERROR). Default: INFO in dev.
# DJANGO_LOG_LEVEL=INFO

# Comma-separated hostnames (Render: your-app.onrender.com)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Public base URL for links in emails (production)
# CHURCHHUB_PUBLIC_URL=https://your-app.onrender.com

# First deploy on Render: set to 1, then 0 after bootstrap succeeds
# CHURCHHUB_BOOTSTRAP=1

# Platform owner (required when CHURCHHUB_BOOTSTRAP=1 in production)
# DJANGO_SUPERUSER_USERNAME=platform
# DJANGO_SUPERUSER_EMAIL=owner@your-domain.example
# DJANGO_SUPERUSER_PASSWORD=use-a-strong-password

# Optional: seed demo church hierarchy without sample transactions
# CHURCHHUB_BOOTSTRAP_DEMO=1

# Persistent media path (e.g. Render Disk mount)
# MEDIA_ROOT=/var/data/media

# --- PostgreSQL (production) ---
# Option A: individual vars
# DB_ENGINE=postgresql
# DB_NAME=churchhub
# DB_USER=churchhub
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=600

# Option B: single URL (requires dj-database-url)
# DATABASE_URL=postgresql://churchhub:password@localhost:5432/churchhub

# --- Redis (production — shared cache & rate limiting) ---
# REDIS_URL=redis://localhost:6379/0

# --- Celery (background jobs) ---
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Invitation emails send synchronously by default. Only enable async when a worker is running:
# CHURCHHUB_ASYNC_EMAIL=1

# --- Email / SMTP (optional env fallback; Platform → Email is preferred) ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=you@gmail.com
# Or use Platform Control → Email in the UI (recommended).

# --- Error monitoring (optional) ---
# SENTRY_DSN=https://example@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Production HTTPS (when DEBUG=False) ---
# SECURE_SSL_REDIRECT=True

# Comma-separated origins for CSRF behind HTTPS
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
