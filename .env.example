# ChurchHub environment variables
# Copy to .env and adjust (do not commit .env)
#
# Environments: set DJANGO_ENV=development|staging|production
# Or use DJANGO_SETTINGS_MODULE=church_system.settings.production

# --- Core ---
DJANGO_ENV=development
DJANGO_SETTINGS_MODULE=church_system.settings
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Development: True | Staging/Production: False
# If unset: True locally; False when DATABASE_URL / RENDER / PYTHONANYWHERE_SITE / DYNO is set.
# Explicit True on production-like hosts requires DJANGO_ALLOW_DEBUG_IN_PROD=True (temporary only).
DJANGO_DEBUG=True
# DJANGO_ALLOW_DEBUG_IN_PROD=False

# Console / file log level
# DJANGO_LOG_LEVEL=INFO
# CHURCHHUB_FILE_LOGS=false
# CHURCHHUB_LOG_DIR=logs
# CHURCHHUB_LOG_MAX_BYTES=10485760
# CHURCHHUB_LOG_BACKUP_COUNT=10

# Comma-separated hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Public base URL for emails / absolute links (site ROOT only — no /dashboard/)
# PythonAnywhere example:
# CHURCHHUB_PUBLIC_URL=https://churchhub.pythonanywhere.com
# Never use https://www.pythonanywhere.com — invitation links will break.
# CHURCHHUB_PUBLIC_URL=https://your-app.example.com

# First deploy bootstrap (set to 0 after success)
# CHURCHHUB_BOOTSTRAP=1
# DJANGO_SUPERUSER_USERNAME=platform
# DJANGO_SUPERUSER_EMAIL=owner@your-domain.example
# DJANGO_SUPERUSER_PASSWORD=use-a-strong-password
# CHURCHHUB_BOOTSTRAP_DEMO=1

# Persistent media path (Render Disk / VPS mount)
# MEDIA_ROOT=/var/data/media

# Upload limits (bytes). Defaults: images 5MB, documents 10MB, branding 2MB.
# CHURCHHUB_MAX_IMAGE_BYTES=5242880
# CHURCHHUB_MAX_DOCUMENT_BYTES=10485760
# CHURCHHUB_MAX_BRANDING_BYTES=2097152
# CHURCHHUB_MAX_REQUEST_UPLOAD_BYTES=12582912
# DATA_UPLOAD_MAX_MEMORY_SIZE=12582912
# FILE_UPLOAD_MAX_MEMORY_SIZE=12582912

# --- Database (required for staging/production / PythonAnywhere) ---
# Option A — PostgreSQL URL:
# DATABASE_URL=postgresql://churchhub:password@localhost:5432/churchhub
#
# Option B — Explicit PostgreSQL:
# DB_ENGINE=postgresql
# DB_NAME=churchhub
# DB_USER=churchhub
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
#
# Option C — MySQL (paid PythonAnywhere / self-hosted):
# DB_ENGINE=mysql
# DB_NAME=ChurchHub$default
# DB_USER=ChurchHub
# DB_PASSWORD=your-mysql-password
# DB_HOST=ChurchHub.mysql.pythonanywhere-services.com
# DB_PORT=3306
#
# PythonAnywhere free tier: omit DATABASE_URL and DB_ENGINE — SQLite (db.sqlite3) is used.
# To force SQLite explicitly: CHURCHHUB_ALLOW_SQLITE=true
# DB_CONN_MAX_AGE=600
# DB_SSL_REQUIRE=false

# --- Redis (Docker/Render: required; PythonAnywhere: optional LocMem) ---
# When set, ChurchHub uses Redis for:
#   - Django cache (rate limits, MFA OTP, settings, dashboard)
#   - Session cached_db (fast cache + DB durability)
#   - Celery broker/result (async reports, email, depreciation)
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# On PythonAnywhere without Redis, leave REDIS_URL unset (LocMem allowed).
# CHURCHHUB_REQUIRE_REDIS=false
# CACHE_KEY_PREFIX=churchhub
# CACHE_DEFAULT_TIMEOUT=300
# CACHE_VERSION=1
# Sessions use cached_db when Redis is configured (DB-backed + cache):
# CHURCHHUB_SESSION_CACHE=true

# --- Celery ---
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# CELERY_TASK_ALWAYS_EAGER=false
# CELERY_TASK_TIME_LIMIT=600
# CELERY_TASK_SOFT_TIME_LIMIT=540
# CHURCHHUB_CELERY_BEAT=true
# Invitation emails are sync by default. Enable only when a worker is running:
# CHURCHHUB_ASYNC_EMAIL=1

# --- Optional S3-compatible media (requires django-storages[boto3]) ---
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=
# AWS_QUERYSTRING_AUTH=true
# CHURCHHUB_MANIFEST_STATIC=false

# --- Email / SMTP (Platform → Email preferred; env is fallback) ---
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=noreply@example.com

# --- Monitoring ---
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Production security (required when DJANGO_ENV=production) ---
# Protect /health/ probes from public reconnaissance (use a long random string):
# CHURCHHUB_HEALTH_TOKEN=change-me-to-a-long-random-string
# Platform control room IP allowlist (optional):
# Default is false — MFA protects /platform/; leave platform_ip_allowlist empty on dynamic ISPs.
# Set true only when you maintain a non-empty static/VPN IP list in Site Settings:
# CHURCHHUB_REQUIRE_PLATFORM_IP_ALLOWLIST=true

# --- Ubuntu VPS (IP access now, domain later) ---
# DJANGO_ENV=production
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=generate-a-long-unique-secret
# DJANGO_ALLOWED_HOSTS=203.0.113.10
# DJANGO_CSRF_TRUSTED_ORIGINS=http://203.0.113.10
# CHURCHHUB_PUBLIC_URL=http://203.0.113.10
# # Keep false until Nginx TLS + domain are live (avoids secure-cookie / HTTPS redirect lockout):
# SECURE_SSL_REDIRECT=false
# DATABASE_URL=postgres://churchhub:PASSWORD@127.0.0.1:5432/churchhub
# REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# CHURCHHUB_HEALTH_TOKEN=long-random-token
# After domain + certbot:
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# CHURCHHUB_PUBLIC_URL=https://example.com
# SECURE_SSL_REDIRECT=true

# --- HTTPS (when TLS is live) ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_PRELOAD=false
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.example.com

# --- Staging overrides ---
# CHURCHHUB_REQUIRE_REDIS=true
# CHURCHHUB_ALLOW_SQLITE=false

# --- Gunicorn ---
# VPS (behind Nginx): leave defaults — binds 127.0.0.1:8000
# Docker/Render: GUNICORN_HOST=0.0.0.0
# PORT=8000
# GUNICORN_HOST=127.0.0.1
# GUNICORN_BIND=
# GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1
# WEB_CONCURRENCY=2
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=120
# Optional file logs (journal still captures stdout):
# GUNICORN_ACCESS_LOG=/opt/churchhub/logs/gunicorn-access.log
# GUNICORN_ERROR_LOG=/opt/churchhub/logs/gunicorn-error.log
