# Force LF line endings for shell scripts (Windows CRLF breaks Render builds)
*.sh text eol=lf
render.yaml text eol=lf
docker-entrypoint.sh text eol=lf
# Fail2Ban / UFW templates must stay LF on Linux VPS
deploy/fail2ban/** text eol=lf
deploy/firewall/** text eol=lf
deploy/backup/** text eol=lf
deploy/systemd/*.service text eol=lf
deploy/systemd/*.timer text eol=lf
