[Unit]
Description=ChurchHub Celery Worker
Documentation=file:/opt/churchhub/docs/DEVELOPMENT/DEPLOYMENT_NOTES.md
After=network-online.target redis-server.service postgresql.service
Wants=network-online.target redis-server.service postgresql.service

[Service]
Type=simple
User=churchhub
Group=churchhub
WorkingDirectory=/opt/churchhub
EnvironmentFile=-/opt/churchhub/.env
Environment=DJANGO_SETTINGS_MODULE=church_system.settings
Environment=DJANGO_ENV=production
ExecStartPre=/usr/bin/mkdir -p /opt/churchhub/logs /opt/churchhub/var
ExecStart=/opt/churchhub/.venv/bin/celery -A church_system worker \
    --loglevel=INFO \
    --concurrency=2
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=churchhub-celery
PrivateTmp=true
NoNewPrivileges=true
LimitNOFILE=65535
ReadWritePaths=/opt/churchhub/logs /opt/churchhub/var /opt/churchhub/media

[Install]
WantedBy=multi-user.target
