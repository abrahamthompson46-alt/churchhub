[Unit]
Description=ChurchHub Celery Beat
Documentation=file:/opt/churchhub/docs/DEVELOPMENT/DEPLOYMENT_NOTES.md
After=network-online.target redis-server.service churchhub-celery.service
Wants=network-online.target redis-server.service

[Service]
Type=simple
User=churchhub
Group=churchhub
WorkingDirectory=/opt/churchhub
EnvironmentFile=-/opt/churchhub/.env
Environment=DJANGO_SETTINGS_MODULE=church_system.settings
Environment=DJANGO_ENV=production
ExecStartPre=/usr/bin/mkdir -p /opt/churchhub/logs /opt/churchhub/var
ExecStart=/opt/churchhub/.venv/bin/celery -A church_system beat \
    --loglevel=INFO \
    --schedule=/opt/churchhub/var/celerybeat-schedule
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=churchhub-celerybeat
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/opt/churchhub/logs /opt/churchhub/var

[Install]
WantedBy=multi-user.target
