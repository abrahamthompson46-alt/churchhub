[Unit]
Description=ChurchHub Celery Beat
After=network.target redis-server.service churchhub-celery.service
Requires=redis-server.service

[Service]
Type=simple
User=churchhub
Group=churchhub
WorkingDirectory=/opt/churchhub
EnvironmentFile=/opt/churchhub/.env
Environment=DJANGO_SETTINGS_MODULE=church_system.settings
Environment=DJANGO_ENV=production
ExecStart=/opt/churchhub/.venv/bin/celery -A church_system beat \
    --loglevel=INFO \
    --schedule=/opt/churchhub/var/celerybeat-schedule
Restart=always
RestartSec=10
PrivateTmp=true

[Install]
WantedBy=multi-user.target
